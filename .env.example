# 資料目錄（SQLite、掃描工作區）
# 本機執行用 ./data；Docker 由 compose 固定為 /data，並把 ./data 掛載進去
SAST_DATA_DIR=./data

# 偵測引擎：auto | semgrep | regex
SAST_ENGINE=auto

# Semgrep 主規則集：留空使用內建規則 app/rules；也可填 p/default 或自訂路徑
SAST_SEMGREP_CONFIG=

# 額外規則集（逗號分隔，會疊加在主規則集上；registry pack 需要網路）
# 下載失敗時會自動退回內建規則，並在 scan warnings 留下訊息；留空可停用
SAST_SEMGREP_EXTRA_CONFIGS=p/rust
# 其他例子：SAST_SEMGREP_EXTRA_CONFIGS=p/rust,p/secrets
SAST_SEMGREP_BIN=semgrep

# Taint 資料流追蹤：finding 會附上 source → propagator → sink 路徑
# Semgrep OSS 的 taint 分析以單一檔案為主；關閉可縮短掃描時間
SAST_DATAFLOW_TRACES=true
# 內建的跨函式／跨檔案 taint 引擎（tree-sitter）。免費、不需 Semgrep Pro，
# 會在 Semgrep 之後補上跨檔案資料流；關閉可縮短掃描時間
SAST_TAINT_ENGINE=true
# taint 引擎最多解析幾個原始碼檔案（避免大型 repo 掃太久）
SAST_TAINT_MAX_FILES=5000
# 選用：讓 Semgrep 自己跑 --pro 跨檔 taint，需要有效的 SEMGREP_APP_TOKEN
SAST_SEMGREP_PRO=false

# 上傳 / 解壓縮限制
SAST_MAX_UPLOAD_MB=50
SAST_MAX_EXTRACT_MB=200
SAST_MAX_FILES=20000
SAST_MAX_FILE_MB=2

# 單次掃描逾時（秒）
SAST_SCAN_TIMEOUT_SEC=300
SAST_GIT_TIMEOUT_SEC=120

# 背景 worker 數量（僅限單一 uvicorn worker）
SAST_MAX_WORKERS=2

# 設定後 API 需帶 X-API-Key 標頭（UI 不受保護）
SAST_API_KEY=

# 是否允許 Git repo 來源
SAST_ALLOW_GIT_SOURCES=true

# --- 依賴與供應鏈檢查 ---
# 解析 Cargo.lock 並查詢 OSV；需要容器能連外，失敗只留 warning
SAST_OSV_ENABLED=true
SAST_OSV_API_URL=https://api.osv.dev
SAST_OSV_TIMEOUT_SEC=20
SAST_OSV_MAX_PACKAGES=1000
# build.rs、.cargo 設定、git 依賴 pin、萬用版本、Cargo patch
SAST_SUPPLY_CHAIN_ENABLED=true

# ---------------------------------------------------------------------------
# MCP server（獨立程序，透過 HTTP 呼叫上面的 SAST 服務）
# ---------------------------------------------------------------------------

# SAST 服務位址
SAST_BASE_URL=http://127.0.0.1:8000

# 若 SAST 服務設定了 SAST_API_KEY，MCP server 也要帶同一組
# SAST_API_KEY=

# 單次 HTTP 請求逾時（秒）
SAST_MCP_TIMEOUT_SEC=30

# 限制 MCP 可讀取／掃描的本機路徑（os.pathsep 分隔；留空表示不限制）
# 例如：SAST_MCP_ALLOWED_ROOTS=/srv/repos:/opt/projects
SAST_MCP_ALLOWED_ROOTS=

# SARIF 預設輸出目錄（留空使用系統暫存目錄下的 sast-mcp/）
SAST_MCP_EXPORT_DIR=

# 等待掃描完成的預設秒數
SAST_MCP_WAIT_TIMEOUT_SEC=180

# stdio（預設，供本機 Agent 啟動）、streamable-http 或 sse
SAST_MCP_TRANSPORT=stdio
SAST_MCP_HOST=127.0.0.1
SAST_MCP_PORT=8001
SAST_MCP_LOG_LEVEL=INFO

